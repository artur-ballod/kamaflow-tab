include ../helpers/mixins
block variables

doctype html
html(lang="ru-RU")
    head
        //test ver only
        meta(name="robots" content="noindex")
        //end of test ver only
        meta(charset="utf-8")
        title #{title}
        <!--[if IE]>
        meta(http-equiv='X-UA-Compatible', content="IE = edge")
        <![endif]-->
        meta(name="viewport" content="width=device-width,initial-scale=1")
        meta(name="keywords" content="")
        link(rel="stylesheet" type='text/css' href="static/css/styles.css")
        //test ver only
        meta(name="robots" content="noindex")
        //end of test ver only

    body.body
        main.main
        
            .analytic(data-active-year=activeYear)
                .year-selector
                    button(data-year="2025" class=(activeYear === 2025 ? 'active' : '')) 2025
                    button(data-year="2026" class=(activeYear === 2026 ? 'active' : '')) 2026
                .indicator-container
                    .indicator-container__segment.last Last
                    .indicator-container__segment.now Current
                    .indicator-container__segment.future Future

                .analytic-content
                    //- Столбец индикаторов
                    .analytic-aside
                        each group in data.groups
                            div.analytic-aside__block
                                b.analytic-aside__title= group.title
                                each indicator in group.indicators
                                    .analytic-aside__subtitle.indicator-row(data-indicator=indicator.id) 
                                        span.analytic-aside__subtitle-text #{indicator.text}

                    //- Слайдер
                    .analytic-data.slider.swiper-container
                        .swiper-wrapper
                            each month in months
                                .analytic-data__block.swiper-slide(data-month=month.id)
                                    .analytic-data__month= month.name
                                    each group in month.groups
                                        .analytic-data__group
                                            .start-item
                                            .analytic-data__list
                                                each indicator in group.indicators
                                                    .analytic-data__item.indicator-row(data-indicator=indicator.id)= indicator.value
        script#analytics-json(type="application/json")
            != JSON.stringify({ monthsByYear: monthsByYear, initialYear: activeYear })
        script(src="static/js/libs.js")
        script(src="static/js/main.js")
        block script
